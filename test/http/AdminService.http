  }
}


### Result from POST request above
@draftID={{Employees_Draft_POST.response.body.$.ID}}


### Employees Draft PATCH
# @name Employees_Draft_Patch
PATCH {{server}}/odata/v4/admin/Employees(ID={{draftID}},IsActiveEntity=false)
Content-Type: application/json
Authorization: Basic {{username}}:{{password}}


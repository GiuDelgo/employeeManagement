@server=http://localhost:4004
@username=alice
@password=


### Employees
# @name Employees_GET
GET {{server}}/odata/v4/admin/Employees
Authorization: Basic {{username}}:{{password}}


### Employees Drafts GET
# @name Employees_Drafts_GET
GET {{server}}/odata/v4/admin/Employees?$filter=(IsActiveEntity eq false)
Authorization: Basic {{username}}:{{password}}


### Employees Draft POST
# @name Employees_Draft_POST
POST {{server}}/odata/v4/admin/Employees
Content-Type: application/json
Authorization: Basic {{username}}:{{password}}

{
  "firstName": "firstName-10869267",
  "lastName": "lastName-10869267",

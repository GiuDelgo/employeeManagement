@server=http://localhost:4004
@username=alice
@password=


### Employees
# @name Employees_GET
GET {{server}}/odata/v4/hradmin/Employees
Authorization: Basic {{username}}:{{password}}


### Employees Drafts GET
# @name Employees_Drafts_GET
GET {{server}}/odata/v4/hradmin/Employees?$filter=(IsActiveEntity eq false)
Authorization: Basic {{username}}:{{password}}


### Employees Draft POST
# @name Employees_Draft_POST
POST {{server}}/odata/v4/hradmin/Employees
Content-Type: application/json
Authorization: Basic {{username}}:{{password}}

{
  "firstName": "firstName-6436312",
  "lastName": "lastName-6436312",
  "email": "email-6436312",
  "hireDate": "2006-04-26",
  "active": true,
  "department": {
    "code": "ts-4148838"
  },
  "position": {
    "code": "s-27029820"
  },
  "seniority": {
    "code": "90930"
  },
  "manager": {
    "ID": "64363129-147a-4b19-9ef1-0dbe1e9ded52"
  }
}


### Result from POST request above
@draftID={{Employees_Draft_POST.response.body.$.ID}}


### Employees Draft PATCH
# @name Employees_Draft_Patch
PATCH {{server}}/odata/v4/hradmin/Employees(ID={{draftID}},IsActiveEntity=false)
Content-Type: application/json
Authorization: Basic {{username}}:{{password}}

{
  "firstName": "firstName-6436312",
  "lastName": "lastName-6436312",
  "email": "email-6436312",
  "hireDate": "2006-04-26",
  "active": true,
  "department": {
    "code": "ts-4148838"
  },
  "position": {
    "code": "s-27029820"
  },
  "seniority": {
    "code": "90930"
  },
  "manager": {
    "ID": "64363129-147a-4b19-9ef1-0dbe1e9ded52"
  }
}


### Employees Draft Prepare
# @name Employees_Draft_Prepare
POST {{server}}/odata/v4/hradmin/Employees(ID={{draftID}},IsActiveEntity=false)/HRAdminService.draftPrepare
Content-Type: application/json
Authorization: Basic {{username}}:{{password}}

{}


### Employees Draft Activate
# @name Employees_Draft_Activate
POST {{server}}/odata/v4/hradmin/Employees(ID={{draftID}},IsActiveEntity=false)/HRAdminService.draftActivate
Content-Type: application/json
Authorization: Basic {{username}}:{{password}}

{}


### Employees deactivate

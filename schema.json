            {
              "ref": [
                "code"
              ]
            }
          ]
        },
        "position": {
          "type": "cds.Association",
          "target": "sap.capire.employeemanagement.Positions",
          "keys": [
            {
              "ref": [
                "code"
              ]
            }
          ]
        },
        "seniority": {
